# Copy to .env and fill in. This example is sandbox only.

# Primer sandbox API key. Needs the scopes client_tokens:write,
# transactions:authorize, transactions:read and payment_instrument:write.
PRIMER_API_KEY=

# Stripe test secret key (sk_test_... or rk_test_...). Live keys are refused.
STRIPE_SECRET_KEY=

# Primer API host. Default: api.sandbox.primer.io
# PRIMER_API_HOST=api.sandbox.primer.io

# Primer PCI proxy host. Default: proxy.sandbox.primer.io
# PRIMER_PROXY_HOST=proxy.sandbox.primer.io

# API key sent to the proxy. Default: PRIMER_API_KEY
# PRIMER_PROXY_API_KEY=

# Where payments go when nothing else decides: stripe or primer. Default: stripe
# ROUTE=stripe

# Amount in minor units (4999 = 49.99). Default: 4999
# AMOUNT=4999

# ISO 4217 currency code. Default: EUR
# CURRENCY=EUR

# ISO 3166-1 alpha-2 country code of the order. Default: DE
# COUNTRY_CODE=DE

# Interface the server listens on. The endpoints have no authentication,
# so keep this local. Default: 127.0.0.1
# HOST=127.0.0.1

# Port for the local server. Default: 3000
# PORT=3000
