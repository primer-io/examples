{
  "name": "primer-examples",
  "private": true,
  "scripts": {
    "format": "prettier . --write",
    "lint:format": "prettier . --check",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css,scss,html,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0"
  }
}
