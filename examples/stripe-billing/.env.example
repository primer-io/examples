# Copy to .env and fill in. Never commit .env.

# Primer API key (sandbox). Needs these scopes:
# client_tokens:write, transactions:authorize, transactions:read, payment_instrument:read
PRIMER_API_KEY=

# Primer webhook signing secret. Required: PENDING payments normally settle through this webhook.
# Subscribe the webhook to PAYMENT.STATUS.
PRIMER_WEBHOOK_SECRET=

# Primer API host. Defaults to the sandbox.
# PRIMER_API_HOST=api.sandbox.primer.io

# Stripe test-mode secret key (sk_test_... or rk_test_...). Live keys are refused.
STRIPE_SECRET_KEY=

# Signing secret (whsec_...) of the Stripe webhook endpoint for /api/webhooks/stripe.
# Send it one event: invoice.payment_attempt_required
STRIPE_WEBHOOK_SECRET=

# Recurring Price (price_...) the subscription is created with.
STRIPE_PRICE_ID=

# Custom payment method type ID (cpmt_...). Stripe Dashboard > Settings > Payments >
# Custom payment methods. Stripe's API cannot list it, so copy it from the Dashboard.
STRIPE_CPM_TYPE_ID=

# 1 = put each new customer on a new Stripe test clock, so you can advance to the renewal.
# STRIPE_USE_TEST_CLOCK=1

# Interface to listen on. The API routes have no authentication, so keep it on localhost.
# HOST=127.0.0.1
# PORT=3000
