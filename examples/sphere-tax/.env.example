# Copy to .env and fill in. Never commit .env.

# Primer API key (sandbox). Needs these scopes:
# client_tokens:write, transactions:read, transactions:refund
# Primer Checkout authorizes the payment itself with the client token, so no payment scope is needed.
PRIMER_API_KEY=

# Sphere API key. It needs access to both calculate_tax and the Transaction API.
# Use a Sphere test organization: the example records real sales, credit notes and cancellations,
# and nothing in the code can tell a test key from a live one.
SPHERE_API_KEY=

# The Sphere product tax code for the demo products. Ask Sphere which code applies to you.
# `npm run seed` creates or updates the demo products in Sphere with this code.
SPHERE_TAX_CODE=

# Primer API host. Defaults to the sandbox.
# PRIMER_API_HOST=api.sandbox.primer.io

# SQLite file for orders and the Sphere write queue. Relative paths start in this directory.
# DB_PATH=data/orders.db

# Interface to listen on. The API routes have no authentication, so keep it on localhost.
# HOST=127.0.0.1
# PORT=3000
